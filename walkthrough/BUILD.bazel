load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# `serve.py` is exported as a source so `walkthrough_html` can wire
# it into per-walkthrough py_binary targets without each consumer
# needing to redeclare the dependency.
exports_files(
    [
        "serve.py",
        "defs.bzl",
    ],
)

# For stardoc (//docs) and for consumers that document macros which
# wrap `walkthrough_html`.
bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = ["@rules_python//python:defs_bzl"],
)
